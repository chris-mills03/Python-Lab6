{
    "permissions": {
        "allow": [
            "Bash(python3 -m doctest:*)",
            "Bash(ruff check:*)",
            "Bash(ruff format --check:*)", 
            "Bash(git status)",
            "Bash(git diff:*)", 
            "Bash(git log:*)",
            "Edit(password.py)",
            "Bash(uvx ruff check:*)",
            "Bash(uvx ruff format --check:*)",
            "Bash(uvx pytest:*)",
            "Bash(uvx pre-commit run:*)"
        ],
        "ask": [
            "Bash(git add:*)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Bash(git push:*)",
            "Bash(git remote:*)",
            "Edit(/README.md)",
            "Edit(/DIRECTORY.md)",
            "Edit(/CONTRIBUTING.md)",
            "Edit(/AGENTS.md)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_upstream.py\"",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}